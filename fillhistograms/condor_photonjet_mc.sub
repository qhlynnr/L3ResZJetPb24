# HTCondor submit file for the PhotonJet L3 residual analysis - MC.
# Generate photonjet_mc_jobs.txt and submit with:  ./run.sh submit mc
#
# MC is now read from a local/EOS-mounted directory (INPUT_TYPE=directory in
# run.sh, the QCD pThat-15to1200 sample), so like data this needs no grid
# proxy - the execute node reads it the same way as any other EOS path.
# Otherwise identical to condor_photonjet.sub apart from the job list and the
# Condor event log; the is_mc column in photonjet_mc_jobs.txt is what sets
# isMC=true in the analysis. Keeping the two submit files separate means a
# data run and an MC run can be in the queue at the same time without
# overwriting each other's job list.

universe    = vanilla
executable  = run_photonjet_job.sh
arguments   = $(filelist) $(output_tag) $(batch_index) $(total_batches) $(files_per_job) $(jet_tree) $(is_mc) $(input_type)

# Condor's own event log must be on a local filesystem, not EOS/AFS.
log         = /tmp/condor_photonjet_mc.log

# stdout/stderr are redirected to EOS by the wrapper script itself.

should_transfer_files = NO

+JobFlavour = "tomorrow"
request_cpus   = 1
request_memory = 4000

queue filelist,output_tag,batch_index,total_batches,files_per_job,jet_tree,is_mc,input_type from photonjet_mc_jobs.txt
