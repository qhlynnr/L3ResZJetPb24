# One-off smoke test: does a real Condor execute node (not just a local
# ./run.sh test) succeed writing the analysis output to the new AFS
# OUTPUT_DIR set in paths.sh? 5 files from HP0, single job.
#
# Not meant to be kept around - delete this and smoketest_jobs.txt once the
# real data/mc production is confirmed working.

universe    = vanilla
executable  = run_photonjet_job.sh
arguments   = $(filelist) $(output_tag) $(batch_index) $(total_batches) $(files_per_job) $(jet_tree) $(is_mc) $(input_type)

log         = /tmp/condor_photonjet_smoketest.log

should_transfer_files = NO

+JobFlavour = "espresso"
request_cpus   = 1
request_memory = 4000

queue filelist,output_tag,batch_index,total_batches,files_per_job,jet_tree,is_mc,input_type from smoketest_jobs.txt
